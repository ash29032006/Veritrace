# PostgreSQL (source of truth)
DATABASE_URL=postgresql://user:password@localhost:5432/veritrace
# Separate throwaway database used only by scripts/bench-indexes.ts
BENCH_DATABASE_URL=postgresql://user:password@localhost:5432/veritrace_bench

# Neo4j (lineage projection)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Qdrant (vector search)
QDRANT_URL=
QDRANT_API_KEY=

# Sessions: any long random string, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Embedding model (runs locally inside the Next.js server)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Passwords for the two demo accounts created by `npm run db:seed`
SEED_MANUFACTURER_PASSWORD=
SEED_REGULATOR_PASSWORD=
